<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/styles.css" />
  <title>StellaMatch :: Dashboard</title>
</head>
<body>
  <nav class="game-nav">
    <a href="/dashboard">Dashboard</a>
    <a href="/profile">Profile Lab</a>
    <a href="/character-hub">Character Hub</a>
    <a href="/matches">Realtime Sessions</a>
    <a href="/leaderboard">Leaderboard</a>
    <a href="/logout" style="margin-left:auto; color:#ff8686;">Logout</a>
  </nav>

  <main class="game-shell">
    <section class="grid-2">
      <article class="panel">
        <div style="display:flex;justify-content:space-between;align-items:center; gap:10px;">
          <h1 class="hero-title"><%= user.name %></h1>
          <div class="pixel-sprite"></div>
        </div>
        <p class="stat">CITY: <%= user.city || 'Unknown' %></p>
        <p class="stat">SKILL VALUE: <%= user.skillValue || 0 %> / 100</p>
        <p class="stat">SKILL POINTS: <%= user.skillPoints || 0 %></p>
        <p class="stat">SKILL LEVEL: <%= user.level || 'Beginner' %></p>
        <p class="stat">XP: <%= user.xp || 0 %> | GAMIFIED LVL: <%= levelFromXp %></p>
        <div class="progress"><span style="width:<%= Math.min(100, (user.xp || 0) % 100) %>%"></span></div>
        <div style="margin-top:10px;">
          <% (badges || []).forEach((badge) => { %><span class="badge"><%= badge %></span><% }) %>
        </div>
      </article>

      <article class="panel">
        <h2 class="hero-title" style="font-size:14px;">PROJECT GRADER (CHARACTER XP)</h2>
        <form method="POST" action="/character/project-grade">
          <input name="title" placeholder="PROJECT TITLE" required />
          <label class="subtitle">DIFFICULTY (1-5)</label>
          <input name="difficulty" type="number" min="1" max="5" value="3" required />
          <label class="subtitle">SIZE (1-5)</label>
          <input name="size" type="number" min="1" max="5" value="3" required />
          <button type="submit">GRADE PROJECT & AWARD XP</button>
        </form>
      </article>
    </section>

    <section class="panel" style="margin-top:16px;">
      <h2 class="hero-title" style="font-size:14px;">TOP 5 AGENTIC MATCH SUGGESTIONS</h2>
      <% if (!suggested.length) { %><p class="subtitle">No suggested matches yet. Add skill tags in profile lab.</p><% } %>
      <div class="grid-3">
        <% suggested.forEach((m) => { %>
          <div class="panel" style="padding:10px;">
            <div class="sparkle"></div>
            <p class="stat">USER ID: <%= m.userB %></p>
            <p class="stat">LEARN: <%= m.skillRequested %></p>
            <p class="stat">TEACH: <%= m.skillOffered %></p>
            <p class="stat">SYNC: <%= (m.score * 100).toFixed(1) %>%</p>
          </div>
        <% }) %>
      </div>
    </section>
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Dashboard | StellaMatch</title>
</head>
<body class="bg-slate-100 min-h-screen">
  <nav class="bg-white shadow p-4 flex gap-4">
    <a href="/dashboard" class="font-semibold">Dashboard</a>
    <a href="/profile">Profile</a>
    <a href="/matches">Matches</a>
    <a href="/leaderboard">Leaderboard</a>
    <a href="/logout" class="ml-auto text-red-600">Logout</a>
  </nav>

  <main class="max-w-6xl mx-auto p-6 grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-white rounded-xl shadow p-5">
      <h2 class="font-bold text-lg"><%= user.name %></h2>
      <p>Skill Value: <span class="font-semibold"><%= user.skillValue || 0 %>/100</span></p>
      <p>Skill Level: <span class="font-semibold"><%= user.level || 'Beginner' %></span></p>
      <p>XP: <span class="font-semibold"><%= user.xp || 0 %></span></p>
      <p>Gamified Level: <span class="font-semibold"><%= levelFromXp %></span></p>
      <div class="mt-2">
        <% (badges || []).forEach((badge) => { %>
          <span class="inline-block bg-indigo-100 text-indigo-700 text-xs px-2 py-1 rounded mr-1 mb-1"><%= badge %></span>
        <% }) %>
      </div>
      <div class="mt-4">
        <div class="h-2 bg-slate-200 rounded">
          <div class="h-2 bg-indigo-600 rounded" style="width: <%= Math.min(100, (user.xp || 0) % 100) %>%"></div>
        </div>
        <p class="text-xs text-slate-500 mt-1">XP progress to next level</p>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow p-5 md:col-span-2">
      <h3 class="font-semibold text-lg mb-3">Suggested Matches</h3>
      <% if (!suggested.length) { %>
        <p class="text-slate-500">No matches yet. Add more skills and come back soon.</p>
      <% } %>
      <div class="space-y-3">
      <% suggested.forEach((m) => { %>
        <div class="border rounded p-3">
          <p class="font-medium">Match User ID: <%= m.userB %></p>
          <p>You can learn: <span class="font-semibold"><%= m.skillRequested %></span></p>
          <p>You can teach: <span class="font-semibold"><%= m.skillOffered %></span></p>
          <p class="text-sm text-slate-500">Compatibility: <%= (m.score * 100).toFixed(1) %>%</p>
        </div>
      <% }) %>
      </div>
    </div>
  </main>
</body>
</html>
