<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/styles.css" />
  <title>StellaMatch :: Dashboard</title>
</head>
<body>
  <nav class="game-nav">
    <a href="/dashboard">Dashboard</a>
    <a href="/profile">Profile Lab</a>
    <a href="/character-hub">Character Hub</a>
    <a href="/matches">Realtime Sessions</a>
    <a href="/leaderboard">Leaderboard</a>
    <a href="/logout" style="margin-left:auto; color:#ff8686;">Logout</a>
  </nav>

  <main class="game-shell">
    <section class="grid-2">
      <article class="panel">
        <div style="display:flex;justify-content:space-between;align-items:center; gap:10px;">
          <h1 class="hero-title"><%= user.name %></h1>
          <div class="pixel-sprite"></div>
        </div>
        <p class="stat">CITY: <%= user.city || 'Unknown' %></p>
        <p class="stat">SKILL VALUE: <%= user.skillValue || 0 %> / 100</p>
        <p class="stat">SKILL POINTS: <%= user.skillPoints || 0 %></p>
        <p class="stat">SKILL LEVEL: <%= user.level || 'Beginner' %></p>
        <p class="stat">XP: <%= user.xp || 0 %> | GAMIFIED LVL: <%= levelFromXp %></p>
        <div class="progress"><span style="width:<%= Math.min(100, (user.xp || 0) % 100) %>%"></span></div>
        <div style="margin-top:10px;">
          <% (badges || []).forEach((badge) => { %><span class="badge"><%= badge %></span><% }) %>
        </div>
      </article>

      <article class="panel">
        <h2 class="hero-title" style="font-size:14px;">PROJECT GRADER (CHARACTER XP)</h2>
        <form method="POST" action="/character/project-grade">
          <input name="title" placeholder="PROJECT TITLE" required />
          <label class="subtitle">DIFFICULTY (1-5)</label>
          <input name="difficulty" type="number" min="1" max="5" value="3" required />
          <label class="subtitle">SIZE (1-5)</label>
          <input name="size" type="number" min="1" max="5" value="3" required />
          <button type="submit">GRADE PROJECT & AWARD XP</button>
        </form>
      </article>
    </section>

    <section class="panel" style="margin-top:16px;">
      <h2 class="hero-title" style="font-size:14px;">TOP 5 AGENTIC MATCH SUGGESTIONS</h2>
      <% if (!suggested.length) { %><p class="subtitle">No suggested matches yet. Add skill tags in profile lab.</p><% } %>
      <div class="grid-3">
        <% suggested.forEach((m) => { %>
          <div class="panel" style="padding:10px;">
            <div class="sparkle"></div>
            <p class="stat">USER ID: <%= m.userB %></p>
            <p class="stat">LEARN: <%= m.skillRequested %></p>
            <p class="stat">TEACH: <%= m.skillOffered %></p>
            <p class="stat">SYNC: <%= (m.score * 100).toFixed(1) %>%</p>
          </div>
        <% }) %>
      </div>
    </section>
  </main>
</body>
</html>
