<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/styles.css" />
  <title>StellaMatch :: Guild Chat</title>
</head>
<body>
  <nav class="game-nav">
    <a href="/dashboard">Dashboard</a>
    <a href="/profile">Profile Lab</a>
    <a href="/character-hub">Character Hub</a>
    <a href="/matches">Realtime Sessions</a>
    <a href="/friends-hub">Guild Chat + Video</a>
    <a href="/skill-arena">Skill Arena</a>
    <a href="/leaderboard">Leaderboard</a>
    <a href="/logout" style="margin-left:auto; color:#ff8686;">Logout</a>
  </nav>

  <main class="game-shell">
    <section class="panel" style="margin-bottom:16px;">
      <h2 class="hero-title" style="font-size:14px;">PLAYER HUD</h2>
      <p class="stat">Hero: <%= user.name %></p>
      <p class="stat">XP: <%= user.xp || 0 %> | Stella: <%= user.stellaPoints || 0 %> | Allies: <%= (user.friends || []).length %></p>
    </section>

    <section class="grid-2">
    <section class="panel">
      <h1 class="hero-title">GUILD FRIEND CHANNELS</h1>
      <% if (!(user.friends || []).length) { %>
        <p class="subtitle">No guild allies yet. Accept requests on dashboard to unlock chat + video.</p>
      <% } %>
      <% (user.friends || []).forEach((friend) => { %>
        <p class="stat">
          <a href="/friends-hub?friend=<%= friend._id %>"><%= friend.name %></a>
          | XP <%= friend.xp %> | SP <%= friend.stellaPoints %>
        </p>
      <% }) %>
    </section>

      <section class="panel">
        <% if (selectedFriend) { %>
          <h2 class="hero-title" style="font-size:14px;">CHAT WITH <%= selectedFriend.name %></h2>
          <div style="max-height:220px; overflow:auto; margin-bottom:10px;">
            <% messages.forEach((message) => { %>
              <p class="stat"><%= message.fromUser.name %>: <%= message.content %></p>
            <% }) %>
          </div>
          <form method="POST" action="/friends/message">
            <input type="hidden" name="toUserId" value="<%= selectedFriend._id %>" />
            <input name="content" placeholder="send guild message" required />
            <button type="submit">CAST MESSAGE SPELL</button>
          </form>

          <h3 class="hero-title" style="font-size:12px; margin-top:16px;">VIDEO QUEST ROOM</h3>
          <p class="subtitle">Instant party video via Jitsi room: <%= videoRoom %></p>
          <iframe
            src="https://meet.jit.si/<%= videoRoom %>"
            style="width:100%; height:300px; border:3px solid #fff; background:#111;"
            allow="camera; microphone; fullscreen; display-capture"
            title="video-room"
          ></iframe>
        <% } else { %>
          <p class="subtitle">Pick a friend to open chat + video room.</p>
        <% } %>
      </section>
    </section>
  </main>
</body>
</html>
