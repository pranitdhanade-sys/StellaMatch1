<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Leaderboard | StellaMatch</title>
</head>
<body class="bg-slate-100 min-h-screen">
  <nav class="bg-white shadow p-4 flex gap-4">
    <a href="/dashboard">Dashboard</a>
    <a href="/profile">Profile</a>
    <a href="/matches">Matches</a>
    <a href="/leaderboard" class="font-semibold">Leaderboard</a>
    <a href="/logout" class="ml-auto text-red-600">Logout</a>
  </nav>

  <main class="max-w-4xl mx-auto p-6">
    <h1 class="text-2xl font-bold mb-4">Top 50 Learners</h1>
    <div class="bg-white rounded-xl shadow overflow-hidden">
      <table class="w-full text-left">
        <thead class="bg-slate-100">
          <tr>
            <th class="p-3">Rank</th>
            <th class="p-3">Name</th>
            <th class="p-3">XP</th>
            <th class="p-3">Skill Value</th>
            <th class="p-3">Level</th>
            <th class="p-3">Badges</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach((u, idx) => { %>
            <tr class="border-t">
              <td class="p-3"><%= idx + 1 %></td>
              <td class="p-3"><%= u.name %></td>
              <td class="p-3"><%= u.xp %></td>
              <td class="p-3"><%= u.skillValue || 0 %></td>
              <td class="p-3"><%= u.level || 'Beginner' %></td>
              <td class="p-3"><%= (u.badges || []).join(', ') || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
