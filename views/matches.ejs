<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/socket.io/socket.io.js"></script>
  <title>Matches | StellaMatch</title>
</head>
<body class="bg-slate-100 min-h-screen">
  <nav class="bg-white shadow p-4 flex gap-4">
    <a href="/dashboard">Dashboard</a>
    <a href="/profile">Profile</a>
    <a href="/matches" class="font-semibold">Matches</a>
    <a href="/leaderboard">Leaderboard</a>
    <a href="/logout" class="ml-auto text-red-600">Logout</a>
  </nav>

  <main class="max-w-5xl mx-auto p-6">
    <h1 class="text-2xl font-bold mb-4">Your Matches</h1>
    <div class="grid gap-4">
      <% matches.forEach((m) => { const peer = String(m.userA._id) === String(currentUserId) ? m.userB : m.userA; %>
        <div class="bg-white rounded-xl shadow p-4">
          <p class="font-semibold"><%= peer.name %></p>
          <p>Offered: <%= m.skillOffered %> | Requested: <%= m.skillRequested %></p>
          <p>Status: <span class="capitalize"><%= m.status %></span></p>
          <div class="mt-2 flex gap-2">
            <input id="msg-<%= m._id %>" class="border rounded p-2 flex-1" placeholder="Message..." />
            <button class="bg-indigo-600 text-white px-3 rounded" onclick="sendMessage('<%= m._id %>')">Send</button>
          </div>
          <div id="feed-<%= m._id %>" class="mt-2 text-sm text-slate-600"></div>
        </div>
      <% }) %>
    </div>
  </main>

  <script>
    const socket = io();
    const roomIds = <%- JSON.stringify(matches.map(m => String(m._id))) %>;
    roomIds.forEach(roomId => socket.emit('join_private_room', { roomId }));

    socket.on('session_message', ({ roomId, message, senderId, at }) => {
      const feed = document.getElementById(`feed-${roomId}`);
      if (feed) {
        const p = document.createElement('p');
        p.textContent = `[${new Date(at).toLocaleTimeString()}] ${senderId}: ${message}`;
        feed.prepend(p);
      }
    });

    function sendMessage(roomId) {
      const input = document.getElementById(`msg-${roomId}`);
      if (!input.value.trim()) return;
      socket.emit('session_message', {
        roomId,
        message: input.value,
        senderId: '<%= currentUserId %>'
      });
      input.value = '';
    }
  </script>
</body>
</html>
