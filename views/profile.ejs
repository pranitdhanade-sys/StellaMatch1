<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Profile | StellaMatch</title>
</head>
<body class="bg-slate-100 min-h-screen">
  <nav class="bg-white shadow p-4 flex gap-4">
    <a href="/dashboard">Dashboard</a>
    <a href="/profile" class="font-semibold">Profile</a>
    <a href="/matches">Matches</a>
    <a href="/leaderboard">Leaderboard</a>
    <a href="/logout" class="ml-auto text-red-600">Logout</a>
  </nav>

  <main class="max-w-3xl mx-auto p-6">
    <div class="bg-white rounded-xl shadow p-6 space-y-2">
      <h1 class="text-2xl font-bold"><%= user.name %></h1>
      <p>Email: <%= user.email %></p>
      <p>GitHub: <%= user.githubUsername || 'Not provided' %></p>
      <p>Portfolio: 
        <% if (user.portfolioLink) { %>
          <a class="text-indigo-600" href="<%= user.portfolioLink %>" target="_blank">Open</a>
        <% } else { %>
          Not provided
        <% } %>
      </p>
      <p>Resume:
        <% if (user.resumePath) { %>
          <a class="text-indigo-600" href="<%= user.resumePath %>" target="_blank">Download PDF</a>
        <% } else { %>
          Not uploaded
        <% } %>
      </p>
      <p>Skills: <%= (user.skills || []).join(', ') || 'No skills yet' %></p>
      <p>Skill Value: <%= user.skillValue || 0 %></p>
      <p>Platform Level (Skill): <%= user.level || 'Beginner' %></p>
      <p>Gamified Level (XP): <%= levelFromXp %></p>
    </div>
  </main>
</body>
</html>
