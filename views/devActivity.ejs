<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/styles.css" />
  <title>StellaMatch :: Developer Activity</title>
</head>
<body>
  <nav class="game-nav">
    <a href="/dashboard">Dashboard</a>
    <a href="/friends-hub">Guild Chat + Video</a>
    <a href="/skill-arena">Skill Arena</a>
    <a href="/developer/activity">Developer Activity</a>
    <a href="/leaderboard">Leaderboard</a>
    <a href="/logout" style="margin-left:auto; color:#ff8686;">Logout</a>
  </nav>

  <main class="game-shell grid-2">
    <section class="panel">
      <h1 class="hero-title" style="font-size:14px;">NEW USER REGISTRATIONS</h1>
      <% if (!recentRegistrations.length) { %><p class="subtitle">No registrations logged yet.</p><% } %>
      <div style="max-height:350px; overflow:auto;">
        <% recentRegistrations.forEach((log) => { %>
          <p class="stat">
            <%= new Date(log.createdAt).toLocaleString() %> | <%= log.user?.name || 'Unknown' %>
            (<%= log.user?.email || '-' %>) from <%= log.user?.city || '-' %>
          </p>
        <% }) %>
      </div>
    </section>

    <section class="panel">
      <h2 class="hero-title" style="font-size:14px;">USER LOGIN TRACKER</h2>
      <% if (!recentLogins.length) { %><p class="subtitle">No login events logged yet.</p><% } %>
      <div style="max-height:350px; overflow:auto;">
        <% recentLogins.forEach((log) => { %>
          <p class="stat">
            <%= new Date(log.createdAt).toLocaleString() %> | <%= log.user?.name || 'Unknown' %>
            (<%= log.user?.email || '-' %>)
          </p>
        <% }) %>
      </div>
    </section>

    <section class="panel" style="grid-column: 1 / -1;">
      <h2 class="hero-title" style="font-size:14px;">LATEST USER PROFILES SNAPSHOT</h2>
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>City</th>
            <th>XP</th>
            <th>Stella</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          <% latestUsers.forEach((u) => { %>
            <tr>
              <td><%= u.name %></td>
              <td><%= u.email %></td>
              <td><%= u.city || '-' %></td>
              <td><%= u.xp || 0 %></td>
              <td><%= u.stellaPoints || 0 %></td>
              <td><%= new Date(u.createdAt).toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </main>
</body>
</html>
